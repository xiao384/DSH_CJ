# ============================================================
# DSH QQ Browser Bridge - configuration
# Copy this file to `.env` and fill in the values.
# ============================================================

# ---- Bridge mode ----
# "dsh"      -> forward QQ chats to a running DeepSeek Harness (DSH) instance.
#               DSH launches the browser MCP server (see BROWSER_MCP_CMD) and
#               gives the DS agent browser powers. This mirrors qq-bridge.
# "deepseek" -> standalone mode: the bridge itself runs the DeepSeek agent loop
#               with browser tools. Fully runnable with just a DeepSeek API key.
BRIDGE_MODE=dsh

# ---- OneBot v11 (SnowLuma / NapCat / Lagrange) ----
# Forward WebSocket: the bridge connects to the OneBot WS endpoint.
ONEBOT_URL=ws://127.0.0.1:3001
# Access token if your OneBot end requires one (leave empty if none).
ONEBOT_TOKEN=
# Reverse WebSocket: if set, the bridge hosts a WS server on this port and the
# OneBot end connects to it (ws://<host>:<port>). Takes priority over ONEBOT_URL.
ONEBOT_REVERSE_PORT=
# Bot owner QQ (used for admin commands like /browser reset).
OWNER_QQ=

# ---- DSH (only used when BRIDGE_MODE=dsh) ----
# DSH local Web API base. qq-bridge talks to 127.0.0.1:3080 over signed RPC.
DSH_BASE_URL=http://127.0.0.1:3080
# Local signing key used to mint session cookies / authenticate RPC.
DSH_SIGN_KEY=
# Default model pinned to a session (optional).
DSH_MODEL=

# ---- DeepSeek (only used when BRIDGE_MODE=deepseek) ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Browser automation ----
# When BRIDGE_MODE=dsh, DSH launches this command as an MCP server.
# (Relative to the bridge project; adjust if deployed elsewhere.)
BROWSER_MCP_CMD=npx tsx src/cli.ts mcp
# Max planner steps for a high-level browser task (browser_run_task).
BROWSER_MAX_STEPS=20
# Viewport size for the controlled browser.
BROWSER_WIDTH=1280
BROWSER_HEIGHT=800

# ---- Behavior ----
# Comma-separated group IDs the bot should respond in (empty = all).
ALLOWED_GROUPS=
# Require an @mention or a trigger prefix in groups? "mention" | "prefix" | "always"
GROUP_TRIGGER=mention
# Command prefix for slash-style commands (e.g. /browser, /reset).
COMMAND_PREFIX=/
# Max characters per QQ message segment.
QQ_MESSAGE_LIMIT=1500
